+def _gradient(f, x):
+    """np.gradient(f, x, axis=0) for 1-D increasing x (2nd-order interior, 1st-order
+    edges), without numpy's generic-argument overhead. Same formula as numpy."""
+    out = np.empty_like(f)
+    dx = np.diff(x)
+    dx1, dx2 = dx[:-1], dx[1:]
+    a = -dx2/(dx1*(dx1+dx2))
+    b = (dx2-dx1)/(dx1*dx2)
+    c = dx1/(dx2*(dx1+dx2))
+    if f.ndim == 2:
+        a, b, c = a[:, None], b[:, None], c[:, None]
+    out[1:-1] = a*f[:-2] + b*f[1:-1] + c*f[2:]
+    out[0] = (f[1]-f[0])/dx[0]
+    out[-1] = (f[-1]-f[-2])/dx[-1]
+    return out
+
