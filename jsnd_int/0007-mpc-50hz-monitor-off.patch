From 22ab8de11fe69ebd756db74928ce3932ed51a35a Mon Sep 17 00:00:00 2001
From: jsnd <jsnd@localhost>
Date: Sun, 22 Nov 2026 14:41:15 +0900
Subject: [PATCH] MPC mode: 50 Hz default, deadline/OSQP limit scale with rate,
 mpc_monitor off by default

---
 stack_master/launch/race.launch.xml | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/stack_master/launch/race.launch.xml b/stack_master/launch/race.launch.xml
index 17ced42..f5c6269 100644
--- a/stack_master/launch/race.launch.xml
+++ b/stack_master/launch/race.launch.xml
@@ -25,8 +25,10 @@
        description="pp: legacy Pure-Pursuit + speed control (default). mpc: integrated speed+steering MPC (config/mpc_car.yaml). Any other value starts no controller."/>
   <arg name="mpc_profile" default="lowspeed"
        description="controller:=mpc only: loads config/mpc_profile_&lt;name&gt;.yaml after mpc_car.yaml. lowspeed = 1.0 m/s (real car). exp2mps = 2.0 m/s (wheels-lifted bench experiment only)."/>
-  <arg name="mpc_rate_hz" default="100"
-       description="controller:=mpc only: control loop rate (MPC solved every tick). 40 = previous rate."/>
+  <arg name="mpc_rate_hz" default="50"
+       description="controller:=mpc only: control loop rate (MPC solved every tick). 50 default since 2026-11-22 step 14: the full real-car stack reached only ~89 Hz at 100 (MPC p99 11 ms). MPC deadline = 0.8/rate, OSQP time limit = 0.4/rate (100 Hz -> 8/4 ms as before, 50 Hz -> 16/8 ms)."/>
+  <arg name="mpc_monitor" default="false"
+       description="controller:=mpc only: start mpc_monitor_node (2 Hz summary on /pitwall/mpc_monitor for the pitwall panel). Off by default: the rclpy node costs ~27 % of a core on the car."/>
   <!-- simple_mux options, forwarded through base_system/localization/low_level -->
   <arg name="safety_mode" default="$(eval &quot;'$(var controller)' == 'mpc'&quot;)"
        description="simple_mux latched E-stop: A = stop latch, LB hold = manual drive, RB hold-to-run, restart via /simple_mux/reset_estop. Default on for controller:=mpc, off for pp."/>
@@ -211,13 +213,15 @@
     <!-- speed profile overlay: config/mpc_profile_<mpc_profile>.yaml (unknown name -> launch fails) -->
     <param from="$(find-pkg-share stack_master)/config/mpc_profile_$(var mpc_profile).yaml"/>
     <param name="control_loop_rate_hz" value="$(var mpc_rate_hz)" type="int"/>
+    <param name="mpc_deadline_s" value="$(eval '0.8 / $(var mpc_rate_hz)')" type="float"/>
+    <param name="mpc_solver_time_limit_s" value="$(eval '0.4 / $(var mpc_rate_hz)')" type="float"/>
     <param name="lateral_controller" value="MPC" type="str"/>
     <env name="PYTHONPATH" value="$(var mpc_pydeps):$(env PYTHONPATH '')"/>
   </node>
   <!-- controller:=mpc: low-rate (2 Hz) performance summary for the pitwall panel, separate process,
        subscribe-only on the controller's existing timing/status topics -> /pitwall/mpc_monitor -->
   <node pkg="stack_master" exec="mpc_monitor_node.py" name="mpc_monitor" output="log"
-        if="$(eval &quot;'$(var controller)' == 'mpc'&quot;)">
+        if="$(eval &quot;'$(var controller)' == 'mpc' and '$(var mpc_monitor)'.lower() == 'true'&quot;)">
     <param name="target_hz" value="$(var mpc_rate_hz)" type="float"/>
   </node>
 </launch>
-- 
