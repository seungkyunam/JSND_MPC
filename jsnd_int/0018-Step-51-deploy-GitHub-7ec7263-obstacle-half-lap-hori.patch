diff --git a/controller/controller/mpc/integrated_mpc.py b/controller/controller/mpc/integrated_mpc.py
index e648bc1..d99c9a8 100644
--- a/controller/controller/mpc/integrated_mpc.py
+++ b/controller/controller/mpc/integrated_mpc.py
@@ -29,12 +29,17 @@ class IntegratedConfig(MPCConfig):
     # applies brake_lead_s*v earlier along the path (VESC speed-loop lag -> braking
     # starts before the corner, tightening only). steer_preview_s: steering
     # linearisation/feed-forward reference sampled steer_preview_s*v ahead.
-    ZERO_ALLOWED = ('brake_lead_s', 'steer_preview_s')   # class attribute, not a field
+    ZERO_ALLOWED = ('brake_lead_s', 'steer_preview_s', 'time_weighted_accel_cost')
     brake_lead_s: float = 0.
     steer_preview_s: float = 0.
+    # Opt-in until command/pose delay is measured: equal stage penalties charge
+    # the 20 ms executed action as much as a 50 ms future action (postponement).
+    time_weighted_accel_cost: bool = False
 
     def __post_init__(self):
         super().__post_init__()
+        if type(self.time_weighted_accel_cost) is not bool:
+            raise ValueError('time_weighted_accel_cost must be boolean')
         if self.braking_preview_ratio > 1.:
             raise ValueError('braking preview cannot exceed maximum deceleration')
         for name in ('brake_lead_s', 'steer_preview_s'):
@@ -131,7 +136,10 @@ class IntegratedMPC:
             d[k, 2*k+1] = 1.
             if k: d[k, 2*k-1] = -1.
         self.d = d
-        self.h_base = np.diag(np.tile([config.r_accel, config.r_steer], n)) + config.r_rate*d.T@d
+        penalties = np.tile([config.r_accel, config.r_steer], n)
+        if config.time_weighted_accel_cost:
+            penalties[0::2] *= self.periods / config.preview_dt
+        self.h_base = np.diag(penalties) + config.r_rate*d.T@d
         # Speed rows of the condensed prediction: v_{k+1} = v_0 + sum_j<=k periods_j*a_j.
         # Row 3 of every linearised A_k is [0,0,0,1] and B_k[3] = [period_k, 0], so these
         # rows never change; appended friction rows have fixed sparsity but variable values.
diff --git a/stack_master/config/mpc_profile_step51_5p0.yaml b/stack_master/config/mpc_profile_step51_5p0.yaml
new file mode 100644
index 0000000..753bcd1
--- /dev/null
+++ b/stack_master/config/mpc_profile_step51_5p0.yaml
@@ -0,0 +1,7 @@
+# Offline candidate ONLY. Requires operator approval and verified pose/servo delay.
+# Same 5 m/s ceiling and physical limits as 5p0; no command multiplication.
+# Delay mismatch tests can violate actual-plant lateral limits: not the default.
+controller_manager:
+  ros__parameters:
+    mpc_max_speed_mps: 5.0
+    mpc_time_weighted_accel_cost: true
diff --git a/state_machine/state_machine/state_machine_node.py b/state_machine/state_machine/state_machine_node.py
index aa2e520..3d0159d 100644
--- a/state_machine/state_machine/state_machine_node.py
+++ b/state_machine/state_machine/state_machine_node.py
@@ -1048,7 +1048,12 @@ class StateMachine(Node):
         gap=12.5m) and OVERTAKE never sees the 'no enemy in front' exit. Same idea as
         the 0.5*track_length windows used for the dynamic-opponent checks below."""
         if self.track_length and self.track_length > 0.0:
-            return min(float(horizon_m), max(0.0, self.track_length - self.obstacle_rear_exclusion_m))
+            # Step 51: L-rear_exclusion only rejects the last two metres behind
+            # ego. A passed obstacle 3--4 m behind on the 13.9 m lap still looked
+            # 10--11 m ahead. Use the unambiguous forward half-lap, as the dynamic
+            # opponent checks do, while retaining a larger configured exclusion.
+            return min(float(horizon_m), 0.5 * self.track_length,
+                       max(0.0, self.track_length - self.obstacle_rear_exclusion_m))
         return float(horizon_m)
 
     def _check_enemy_in_front(self) -> bool:
