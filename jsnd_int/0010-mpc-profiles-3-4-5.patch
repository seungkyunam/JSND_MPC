From 6545daaeb999517693145fa8e7933ce91dced8fc Mon Sep 17 00:00:00 2001
From: jsnd <jsnd@localhost>
Date: Mon, 23 Nov 2026 12:31:54 +0900
Subject: [PATCH] Add mpc_profile_3p0/4p0/5p0 (staged MPC speed ramp, caps
 only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 stack_master/config/mpc_car.yaml         | 1 +
 stack_master/config/mpc_profile_3p0.yaml | 8 ++++++++
 stack_master/config/mpc_profile_4p0.yaml | 8 ++++++++
 stack_master/config/mpc_profile_5p0.yaml | 8 ++++++++
 4 files changed, 25 insertions(+)
 create mode 100644 stack_master/config/mpc_profile_3p0.yaml
 create mode 100644 stack_master/config/mpc_profile_4p0.yaml
 create mode 100644 stack_master/config/mpc_profile_5p0.yaml

diff --git a/stack_master/config/mpc_car.yaml b/stack_master/config/mpc_car.yaml
index 9f2af6d..1f6734b 100644
--- a/stack_master/config/mpc_car.yaml
+++ b/stack_master/config/mpc_car.yaml
@@ -4,6 +4,7 @@
 #   mpc_profile_lowspeed.yaml  1.0 m/s, real car (default)
 #   mpc_profile_1p5.yaml       1.5 m/s
 #   mpc_profile_2p25.yaml      2.25 m/s
+#   mpc_profile_3p0.yaml / 4p0 / 5p0   3.0 / 4.0 / 5.0 m/s (staged ramp, step 18)
 #   mpc_profile_exp2mps.yaml   2.0 m/s, wheels-lifted bench experiment only
 # Legacy PP/speed settings stay untouched.
 controller_manager:
diff --git a/stack_master/config/mpc_profile_3p0.yaml b/stack_master/config/mpc_profile_3p0.yaml
new file mode 100644
index 0000000..48d1cb7
--- /dev/null
+++ b/stack_master/config/mpc_profile_3p0.yaml
@@ -0,0 +1,8 @@
+# 3.0 m/s profile (2026-11-23, step 18 staged ramp 2.25 -> 3 -> 4 -> 5). Load with mpc_profile:=3p0.
+# Use only after mpc_profile:=2p25 ran on the ground without corner stalls.
+# Only the MPC speed cap changes; steering 0.4 rad / 0.3 rad/s, accel 1.0 m/s^2, lateral accel
+# 2.0 m/s^2 (limits corner speed), waypoint speed caps, VESC speed_max 23250 ERPM as before.
+# LB manual (joy_max_speed 1.0), A latch, PP/FTG unchanged. Not yet driven on the ground.
+controller_manager:
+  ros__parameters:
+    mpc_max_speed_mps: 3.0
diff --git a/stack_master/config/mpc_profile_4p0.yaml b/stack_master/config/mpc_profile_4p0.yaml
new file mode 100644
index 0000000..cf99250
--- /dev/null
+++ b/stack_master/config/mpc_profile_4p0.yaml
@@ -0,0 +1,8 @@
+# 4.0 m/s profile (2026-11-23, step 18 staged ramp 2.25 -> 3 -> 4 -> 5). Load with mpc_profile:=4p0.
+# Use only after mpc_profile:=3p0 ran on the ground without corner stalls.
+# Only the MPC speed cap changes; steering 0.4 rad / 0.3 rad/s, accel 1.0 m/s^2, lateral accel
+# 2.0 m/s^2 (limits corner speed), waypoint speed caps, VESC speed_max 23250 ERPM as before.
+# LB manual (joy_max_speed 1.0), A latch, PP/FTG unchanged. Not yet driven on the ground.
+controller_manager:
+  ros__parameters:
+    mpc_max_speed_mps: 4.0
diff --git a/stack_master/config/mpc_profile_5p0.yaml b/stack_master/config/mpc_profile_5p0.yaml
new file mode 100644
index 0000000..61ea1fd
--- /dev/null
+++ b/stack_master/config/mpc_profile_5p0.yaml
@@ -0,0 +1,8 @@
+# 5.0 m/s profile (2026-11-23, step 18 staged ramp 2.25 -> 3 -> 4 -> 5). Load with mpc_profile:=5p0.
+# Use only after mpc_profile:=4p0 ran on the ground without corner stalls.
+# Only the MPC speed cap changes; steering 0.4 rad / 0.3 rad/s, accel 1.0 m/s^2, lateral accel
+# 2.0 m/s^2 (limits corner speed), waypoint speed caps, VESC speed_max 23250 ERPM as before.
+# LB manual (joy_max_speed 1.0), A latch, PP/FTG unchanged. Not yet driven on the ground.
+controller_manager:
+  ros__parameters:
+    mpc_max_speed_mps: 5.0
-- 
2.43.0

