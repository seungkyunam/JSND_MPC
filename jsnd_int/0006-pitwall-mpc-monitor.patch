diff --git a/race_utils/pitwall/src/pitwall_panel.cpp b/race_utils/pitwall/src/pitwall_panel.cpp
index ae66bff..b7dad20 100644
--- a/race_utils/pitwall/src/pitwall_panel.cpp
+++ b/race_utils/pitwall/src/pitwall_panel.cpp
@@ -8,6 +8,7 @@
 #include <QPlainTextEdit>
 #include <QFont>
 #include <QTime>
+#include <QTimer>
 
 #include <rviz_common/display_context.hpp>
 #include <rviz_common/ros_integration/ros_node_abstraction_iface.hpp>
@@ -43,6 +44,21 @@ PitwallPanel::PitwallPanel(QWidget * parent)
   }
   layout->addWidget(telemetry_log_, /*stretch=*/1);
 
+  // ===== MPC monitor (controller:=mpc): text summary from mpc_monitor_node, ~2 Hz =====
+  layout->addWidget(new QLabel("MPC monitor:"));
+  mpc_monitor_label_ = new QLabel("MPC monitor: N/A (no /pitwall/mpc_monitor)");
+  {
+    QFont mono("monospace");
+    mono.setStyleHint(QFont::TypeWriter);
+    mpc_monitor_label_->setFont(mono);
+  }
+  mpc_monitor_label_->setTextInteractionFlags(Qt::TextSelectableByMouse);
+  layout->addWidget(mpc_monitor_label_);
+  // No message for 3 s -> show N/A (monitor or car link down); never keep stale numbers.
+  mpc_monitor_stale_timer_ = new QTimer(this);
+  mpc_monitor_stale_timer_->setSingleShot(true);
+  mpc_monitor_stale_timer_->setInterval(3000);
+
   status_label_ = new QLabel("");
   status_label_->setWordWrap(true);
   layout->addWidget(status_label_);
@@ -134,6 +150,8 @@ PitwallPanel::PitwallPanel(QWidget * parent)
   // ROS callbacks (subscription thread) -> GUI thread via queued connection.
   connect(this, &PitwallPanel::stateReceived, this, &PitwallPanel::onStateUpdate);
   connect(this, &PitwallPanel::telemetryReceived, this, &PitwallPanel::onTelemetry);
+  connect(this, &PitwallPanel::mpcMonitorReceived, this, &PitwallPanel::onMpcMonitor);
+  connect(mpc_monitor_stale_timer_, &QTimer::timeout, this, &PitwallPanel::onMpcMonitorStale);
 
   connect(remove_btn, &QPushButton::clicked, this, &PitwallPanel::onRemoveOpponent);
   connect(clear_obs_btn, &QPushButton::clicked, this, &PitwallPanel::onClearObstacles);
@@ -178,6 +196,26 @@ void PitwallPanel::onInitialize()
     [this](const std_msgs::msg::String::SharedPtr msg) {
       Q_EMIT telemetryReceived(QString::fromStdString(msg->data));
     });
+
+  // MPC monitor summary (already rate-limited to ~2 Hz on the car side).
+  mpc_monitor_sub_ = node_->create_subscription<std_msgs::msg::String>(
+    "/pitwall/mpc_monitor", rclcpp::QoS(1),
+    [this](const std_msgs::msg::String::SharedPtr msg) {
+      Q_EMIT mpcMonitorReceived(QString::fromStdString(msg->data));
+    });
+}
+
+void PitwallPanel::onMpcMonitor(const QString & text)
+{
+  if (mpc_monitor_label_) {mpc_monitor_label_->setText(text);}
+  if (mpc_monitor_stale_timer_) {mpc_monitor_stale_timer_->start();}
+}
+
+void PitwallPanel::onMpcMonitorStale()
+{
+  if (mpc_monitor_label_) {
+    mpc_monitor_label_->setText("MPC monitor: N/A (no /pitwall/mpc_monitor for 3 s)");
+  }
 }
 
 void PitwallPanel::onStateUpdate(const QString & state)
