From 91d0e26617a3066c7a5e1dc154fddcfebc4ce34d Mon Sep 17 00:00:00 2001
From: jsnd <jsnd@localhost>
Date: Sun, 22 Nov 2026 14:31:01 +0900
Subject: [PATCH] MPC steer limit 0.4 rad (= FTG/manual), LB manual 1.0 m/s in
 controller:=mpc only

---
 stack_master/config/mpc_car.yaml    | 12 ++++++++----
 stack_master/launch/race.launch.xml |  4 +++-
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/stack_master/config/mpc_car.yaml b/stack_master/config/mpc_car.yaml
index 94d5d3d..af0b78d 100644
--- a/stack_master/config/mpc_car.yaml
+++ b/stack_master/config/mpc_car.yaml
@@ -16,10 +16,14 @@ controller_manager:
     wheelbase: 0.324
     mpc_pose_to_rear_axle_m: 0.0      # /car_state/odom pose is the rear axle
     mpc_geometry_confirmed: true
-    # --- actuator limits: UNMEASURED. Conservative values verified on 2026-11-20 bench
-    #     (mpc-build.vehicle-assets/vehicle.json). Servo 0.487 -/+ 0.99*0.15 = 0.339..0.636,
-    #     inside servo_min/max 0..1 and FTG's 0.4 rad. Raise only after measuring the car. ---
-    mpc_max_steer_rad: 0.15
+    # --- actuator limits: servo mechanical limit / wheel angle still UNMEASURED. ---
+    # 2026-11-22 (step 12): max steer 0.15 -> 0.4 rad = legacy FTG (ftg_max_steer) and
+    #   manual (joy_max_steer) limit already used on this car. Servo = 0.487 -/+ 0.99*0.4
+    #   = 0.091..0.883, inside servo_min/max 0..1 (0..1 <=> +0.492/-0.518 rad); PP uses 0.53.
+    # Rate 0.3 rad/s kept (2026-11-20 bench value). Offline 11_18_6 lap at 1.0 m/s with
+    #   0.4/0.3: max |steer| 0.336, rate saturates at 0.3, max lateral error 0.05 m (same as
+    #   3.2 rad/s). Real servo lag / localisation jumps not modelled -> verify on the car.
+    mpc_max_steer_rad: 0.4
     mpc_max_steer_rate_radps: 0.3
     # --- speed envelope (first low-speed run) ---
     mpc_max_speed_mps: 1.0            # profile overlay sets the active value (2.0 only in mpc_profile_exp2mps.yaml)
diff --git a/stack_master/launch/race.launch.xml b/stack_master/launch/race.launch.xml
index 69e5810..eb384aa 100644
--- a/stack_master/launch/race.launch.xml
+++ b/stack_master/launch/race.launch.xml
@@ -29,7 +29,9 @@
        description="controller:=mpc only: control loop rate (MPC solved every tick). 40 = previous rate."/>
   <!-- simple_mux options, forwarded through base_system/localization/low_level -->
   <arg name="safety_mode" default="$(eval &quot;'$(var controller)' == 'mpc'&quot;)"
-       description="simple_mux latched E-stop: LB/A = stop latch (no manual drive), RB hold-to-run, restart via /simple_mux/reset_estop. Default on for controller:=mpc, off for pp."/>
+       description="simple_mux latched E-stop: A = stop latch, LB hold = manual drive, RB hold-to-run, restart via /simple_mux/reset_estop. Default on for controller:=mpc, off for pp."/>
+  <arg name="joy_max_speed" default="$(eval &quot;'1.0' if '$(var controller)' == 'mpc' else '4.0'&quot;)"
+       description="simple_mux manual (LB) speed at full stick [m/s]. controller:=mpc: 1.0 (= MPC lowspeed). Otherwise legacy 4.0 (low_level default)."/>
   <arg name="mux_rate_hz" default="$(eval &quot;'100' if '$(var controller)' == 'mpc' else '50'&quot;)"
        description="simple_mux output rate. Default 100 Hz for controller:=mpc, legacy 50 Hz otherwise."/>
   <arg name="mpc_pydeps" default="$(env HOME)/JSND_INT/pydeps"
-- 
2.43.0

