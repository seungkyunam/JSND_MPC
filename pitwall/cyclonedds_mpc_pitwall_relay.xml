<?xml version="1.0" encoding="UTF-8" ?>
<!--
  mpc_pitwall_relay 전용 CycloneDDS 프로파일 (이 프로세스에만 적용).

  Domain 173 (차량 내부): mpc_vehicle/config/cyclonedds_vehicle_localhost.xml 과
    동일한 루프백 전용 설정. 차량 스택의 격리는 그대로 유지된다.
  Domain 174 (노트북 관제): Jetson WiFi(wlP1p1s0)로만 노출. 여기에는 relay가
    화이트리스트로 고른 보기용 토픽과 /initialpose 입력만 존재한다.

  두 도메인은 DDS 수준에서 연결되지 않으므로, 노트북에서 /joy, /vesc/*,
  /mpc_vehicle/arm 등을 보내도 173의 Gate/Estop/VESC에 도달할 경로가 없다.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="173">
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1" multicast="true"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <SocketSendBufferSize min="10MB"/>
    </Internal>
  </Domain>
  <Domain id="174">
    <General>
      <Interfaces>
        <NetworkInterface name="wlP1p1s0" multicast="true"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
